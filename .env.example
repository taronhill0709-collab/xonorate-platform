# Auth.js session encryption secret. Generate with `openssl rand -base64 33`.
AUTH_SECRET=

# The site's canonical public URL. Required in every environment, including
# production — without it, Auth.js infers the request protocol per-runtime,
# and Netlify splits this app across two runtimes (proxy.ts on the Edge,
# everything else as a Node function reached via an internal hop) that can
# infer it inconsistently, causing session cookies set in one runtime
# (unprefixed) to be invisible to auth checks in the other (which expects
# __Host-/__Secure- prefixed cookies once it detects HTTPS) — silently
# breaking sign-in. Set to http://localhost:8888 for local `netlify dev`,
# and to the real https:// production URL on Netlify.
AUTH_URL=

# Resend API key + from-address for magic-link sign-in emails.
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Xonorate Media Platform <no-reply@mail.xonorate.com>"

# Optional: override the Postgres connection instead of using Netlify DB's
# automatic getConnectionString() resolution (only needed outside `netlify dev`).
DATABASE_URL=

# Claude API key for the daily content pipeline (server-side only).
ANTHROPIC_API_KEY=

# Shared secret the trigger function uses to invoke the background
# function. Generate with `openssl rand -hex 24`.
DAILY_CONTENT_SECRET=

# Where to email new-draft notifications. Falls back to a console log if unset.
ADMIN_NOTIFICATION_EMAIL=

# Buffer personal API key (org owner only) — publish.buffer.com/settings/api
# Used to post published articles to Xonorate's connected Instagram channel;
# Buffer's own account-level channel linking cross-posts that to Facebook.
BUFFER_API_KEY=

# The channelId of Xonorate's Instagram channel in Buffer (found via the
# Buffer GraphQL API's `channels` query, not shown in Buffer's UI).
BUFFER_INSTAGRAM_CHANNEL_ID=
